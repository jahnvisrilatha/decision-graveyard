# ========================================================
# Decision Graveyard Environment Configuration
# ========================================================

# LLM Provider selection: 'gemini', 'openai', or 'mock'
# If not specified, the system will auto-detect based on available API keys.
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default & Recommended)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Hindsight Persistent Memory Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=decision-graveyard

